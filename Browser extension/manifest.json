{
  "manifest_version": 3,
  "name": "Rozvrh IS MU – export JSON",
  "version": "1.0.0",
  "description": "Načte rozvrh z přihlášeného IS MU a stáhne ho jako JSON pro GitHub Pages.",
  "permissions": ["activeTab", "downloads"],
  "host_permissions": [
    "https://is.muni.cz/*"
  ],
  "action": {
    "default_title": "Exportovat rozvrh z IS MU",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://is.muni.cz/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
